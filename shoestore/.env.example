# คัดลอกค่าเหล่านี้ไปตั้งเป็น environment variable (ดู README.md)
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=shoestore
# ถ้าฐานข้อมูลบนโฮสต์บังคับ TLS ให้ตั้ง DB_TLS=true
# หรือใช้ DATABASE_DSN แทนทั้งหมดก็ได้ เช่น user:pass@tcp(host:3306)/shoestore?charset=utf8mb4&parseTime=True&loc=Local
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345
# เมื่อขึ้นโฮสต์ที่ใช้ HTTPS ให้ตั้งเป็น true
COOKIE_SECURE=false
GIN_MODE=release
# ใส่ IP ของ reverse proxy (เช่น nginx) ถ้ามี เช่น 127.0.0.1
TRUSTED_PROXIES=
